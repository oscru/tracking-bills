# Copy the block you want into .env.local. Only EXPO_PUBLIC_* vars reach the app.
# Restart the dev server after changing it: `pnpm --filter mobile dev --clear`.
#
# Use the new-format publishable key (`sb_publishable_...`), never the legacy
# JWT anon key.

# --- Hosted project (Supabase cloud) ---
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # Project Settings -> API Keys

# --- Local stack (`pnpm db:start`, key from `pnpm db:status`) ---
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
