# `expo start` (committed — public URLs only; Supabase keys go in .env.local,
# which wins over this file). Expo loads .env.development in dev and
# .env.production for `expo export` / EAS builds.
# The landing site — the legal documents the app links to (`pnpm --filter landing dev`).
EXPO_PUBLIC_SITE_URL=http://localhost:4321
