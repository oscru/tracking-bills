{
  "expo": {
    "name": "Genobills",
    "slug": "finance-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "genobills",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.oscru.financetracker"
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./public/favicon-48.png",
      "description": "Tus finanzas, en orden: ingresos, gastos, cuentas y presupuestos.",
      "themeColor": "#F6F7F9",
      "name": "Genobills",
      "shortName": "Genobills"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D0F",
          "dark": {
            "backgroundColor": "#0B0D0F"
          }
        }
      ],
      "expo-sharing",
      "expo-web-browser",
      "expo-notifications",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usa Face ID para desbloquear tu app y proteger tu información financiera."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "161a6fd8-ba55-48ed-86f1-49810c965a61"
      }
    }
  }
}
