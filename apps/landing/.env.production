# `astro build` (committed — public URLs only). Vercel's env vars override
# these, e.g. to point a preview deployment at itself.
# The landing itself (canonical links, sitemap, hreflang).
PUBLIC_SITE_URL=https://genobills.com
# The web app the "Sign in" / "Sign up" buttons open.
PUBLIC_APP_URL=https://app.genobills.com
