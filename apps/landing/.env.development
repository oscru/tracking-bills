# `astro dev` (committed — public URLs only). Override any of these in a
# git-ignored .env.development.local; Vercel's env vars override them too.
# The landing itself (canonical links, sitemap, hreflang).
PUBLIC_SITE_URL=http://localhost:4321
# The web app the "Sign in" / "Sign up" buttons open — `pnpm mobile web` (Expo, port 8081).
PUBLIC_APP_URL=http://localhost:8081
