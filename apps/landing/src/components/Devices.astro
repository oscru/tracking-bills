---
/**
 * Laptop + tablet + phone, each showing a real screenshot of the app at that
 * size (demo data: supabase/snippets/demo-seed.sql). Drawn on a fixed
 * 1100×600 canvas and scaled to the container width by the script below.
 */
import { Image } from 'astro:assets';

import desktop from '../assets/app-screens/devices-desktop.webp';
import phone from '../assets/app-screens/devices-phone.webp';
import tablet from '../assets/app-screens/devices-tablet.webp';
---

<div data-devices class="relative w-full" style="aspect-ratio: 1100 / 600">
  <div data-devices-canvas class="absolute left-0 top-0 h-[600px] w-[1100px] origin-top-left" aria-hidden="true">
    <!-- laptop -->
    <div class="absolute left-[170px] top-0 w-[780px]">
      <div class="rounded-t-[22px] rounded-b-[6px] bg-[#0b0d0f] p-[12px] pb-[14px] shadow-[inset_0_0_0_1.5px_#3a3f46]">
        <div class="relative h-[472px] overflow-hidden rounded-[10px]">
          <Image src={desktop} alt="" widths={[756, 1512]} sizes="756px" class="h-full w-full object-cover object-top" />
        </div>
      </div>
      <div class="relative -mx-[60px] h-[18px] rounded-b-[18px] bg-gradient-to-b from-[#3a3f46] to-[#1a1d21]">
        <div class="mx-auto h-[7px] w-[130px] rounded-b-[8px] bg-[#16191d]"></div>
      </div>
      <div class="mx-auto -mt-1 h-6 w-[85%] rounded-full bg-black/60 blur-xl"></div>
    </div>

    <!-- tablet -->
    <div class="absolute left-[20px] top-[170px] h-[420px] w-[310px] rounded-[30px] bg-[#0b0d0f] p-[13px] shadow-[inset_0_0_0_1.5px_#3a3f46,0_30px_60px_-20px_rgba(0,0,0,0.8)]">
      <div class="relative h-full overflow-hidden rounded-[18px] bg-canvas">
        <Image src={tablet} alt="" widths={[284, 568]} sizes="284px" class="h-full w-full object-cover object-top" />
      </div>
    </div>

    <!-- phone -->
    <div class="absolute right-[40px] top-[215px] h-[375px] w-[180px] rounded-[34px] bg-[#0b0d0f] p-[8px] shadow-[inset_0_0_0_1.5px_#3a3f46,0_30px_60px_-20px_rgba(0,0,0,0.8)]">
      <div class="relative h-full overflow-hidden rounded-[27px] bg-canvas">
        <Image src={phone} alt="" widths={[164, 328, 492]} sizes="164px" class="h-full w-full object-cover object-top" />
      </div>
    </div>
  </div>
</div>

<script>
  const box = document.querySelector<HTMLElement>('[data-devices]');
  const canvas = box?.querySelector<HTMLElement>('[data-devices-canvas]');
  if (box && canvas) {
    const fit = () => (canvas.style.transform = `scale(${box.clientWidth / 1100})`);
    new ResizeObserver(fit).observe(box);
    fit();
  }
</script>
