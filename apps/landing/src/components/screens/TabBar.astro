---
/** The app's floating ink pill navbar + the separate lime "+" — shared by tab screens. */
interface Props {
  active: 'inicio' | 'movs';
}
const { active } = Astro.props;
const tabs = [
  { id: 'inicio', label: 'Inicio' },
  { id: 'movs', label: 'Movimientos' },
  { id: 'ajustes', label: 'Ajustes' },
] as const;
---

<div class="absolute inset-x-3 bottom-3 flex items-center gap-2">
  <div class="flex flex-1 items-center justify-between rounded-full bg-ink/90 p-1 shadow-lg shadow-black/20 backdrop-blur">
    {
      tabs.map((t) =>
        t.id === active ? (
          <span class="lime-fill whitespace-nowrap rounded-full px-3 py-1.5 text-[11px] font-semibold text-ink">{t.label}</span>
        ) : (
          <span class="px-2.5 text-[11px] text-white/55">{t.id === 'movs' ? 'Movs' : t.label}</span>
        ),
      )
    }
  </div>
  <span class="lime-fill flex h-10 w-10 items-center justify-center rounded-full text-xl font-medium leading-none text-ink">+</span>
</div>
