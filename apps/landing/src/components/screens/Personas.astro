---
const people = [
  { name: 'Ana Prueba', initial: 'A', net: '$640.00', note: 'a tu favor', color: '#8B5CF6' },
  { name: 'Luis', initial: 'L', net: 'Parejos', note: '', color: '#0EA5E9' },
  { name: 'Mar', initial: 'M', net: 'US$25.00', note: 'le debes', color: '#F59E0B' },
];
const history = [
  { what: 'Te envió', sub: 'Renta · 1 oct', amount: '$1,200.00', pos: true },
  { what: 'Le enviaste', sub: 'Concierto · 28 sep', amount: 'US$40.00' },
  { what: 'Le enviaste', sub: 'Cena · 21 sep', amount: '$560.00' },
];
---

<div class="px-4">
  <div class="flex items-center gap-2 pb-3">
    <span class="text-lg leading-none text-ink-2">‹</span>
    <p class="text-lg font-bold">Tus personas</p>
  </div>
  <ul class="divide-y divide-line rounded-card border border-line bg-surface">
    {
      people.map((p) => (
        <li class="flex items-center gap-2.5 px-3 py-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full text-[12px] font-bold text-white" style={`background:${p.color}`}>
            {p.initial}
          </span>
          <div class="flex-1">
            <p class="text-[12px] font-medium">{p.name}</p>
            <p class="text-[10px] text-ink-2">Vinculada</p>
          </div>
          <div class="text-right">
            <p class:list={['text-[12px] font-semibold', p.note === 'a tu favor' && 'text-pos']}>{p.net}</p>
            {p.note && <p class="text-[10px] text-ink-2">{p.note}</p>}
          </div>
        </li>
      ))
    }
  </ul>

  <p class="pb-1.5 pt-4 text-[12px] font-semibold">Historial con Ana</p>
  <ul class="divide-y divide-line rounded-card border border-line bg-surface">
    {
      history.map((h) => (
        <li class="flex items-center justify-between px-3 py-2.5">
          <div>
            <p class="text-[12px] font-medium">{h.what}</p>
            <p class="text-[10px] text-ink-2">{h.sub}</p>
          </div>
          <span class:list={['text-[12px] font-semibold', h.pos && 'text-pos']}>{h.amount}</span>
        </li>
      ))
    }
  </ul>

  <span class="mt-3 flex h-10 items-center justify-center rounded-ctl border border-line bg-surface text-[12px] font-semibold">
    Invitar a alguien
  </span>
</div>
