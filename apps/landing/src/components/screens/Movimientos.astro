---
import TabBar from './TabBar.astro';

const days = [
  {
    label: 'Hoy · mar 20',
    total: '−$907.50',
    rows: [
      { name: 'Súper', sub: 'Comida › Súper', amount: '−$842.50', color: '#F59E0B' },
      { name: 'BBVA → Ahorro', sub: 'Transferencia', amount: '$3,000.00', color: '#9CA3AF' },
      { name: 'Café', sub: 'Comida › Café', amount: '−$65.00', color: '#8B5CF6' },
    ],
  },
  {
    label: 'Ayer · lun 19',
    total: '+$18,151.00',
    rows: [
      { name: 'Nómina', sub: 'Ingreso · quincena', amount: '+$18,500.00', color: '#16A34A', pos: true },
      { name: 'Uber', sub: 'Transporte', amount: '−$129.00', color: '#0EA5E9' },
      { name: 'Netflix', sub: 'Suscripciones', amount: '−$220.00', color: '#E5484D' },
    ],
  },
];
---

<div class="px-4">
  <div class="flex items-center justify-between pb-2">
    <p class="text-lg font-bold">Movimientos</p>
    <span class="rounded-full bg-surface px-2.5 py-1 text-[11px] font-medium shadow-sm">Octubre ▾</span>
  </div>
  <div class="mb-3 flex gap-1.5 text-[11px]">
    <span class="rounded-full bg-ink px-2.5 py-1 text-white">Todos</span>
    <span class="rounded-full border border-line bg-surface px-2.5 py-1">Gastos</span>
    <span class="rounded-full border border-line bg-surface px-2.5 py-1">Ingresos</span>
  </div>
  {
    days.map((d) => (
      <section class="mb-3">
        <div class="mb-1.5 flex justify-between rounded-full bg-white/70 px-3 py-1 text-[10px] font-medium text-ink-2 backdrop-blur">
          <span>{d.label}</span>
          <span>{d.total}</span>
        </div>
        <ul class="divide-y divide-line rounded-card border border-line bg-surface">
          {d.rows.map((m) => (
            <li class="flex items-center gap-2.5 px-3 py-2.5">
              <span class="h-7 w-7 shrink-0 rounded-full" style={`background:${m.color}22;box-shadow:inset 0 0 0 7px ${m.color}`} />
              <div class="min-w-0 flex-1">
                <p class="truncate text-[12px] font-medium">{m.name}</p>
                <p class="truncate text-[10px] text-ink-2">{m.sub}</p>
              </div>
              <span class:list={['text-[12px] font-semibold', m.pos && 'text-pos']}>{m.amount}</span>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>
<TabBar active="movs" />
