---
import TabBar from './TabBar.astro';

const movements = [
  { name: 'Súper', sub: 'Comida › Súper · BBVA', amount: '−$842.50', color: '#F59E0B' },
  { name: 'Nómina', sub: 'Ingreso · Nu', amount: '+$18,500.00', color: '#16A34A', pos: true },
  { name: 'BBVA → Ahorro', sub: 'Transferencia', amount: '$3,000.00', color: '#9CA3AF' },
  { name: 'Café', sub: 'Comida › Café · Efectivo', amount: '−$65.00', color: '#8B5CF6' },
];
---

<div class="px-4">
  <div class="flex items-center justify-between pb-3">
    <div>
      <p class="text-[11px] text-ink-2">Hola, Ana</p>
      <p class="text-lg font-bold">Inicio</p>
    </div>
    <span class="flex h-8 w-8 items-center justify-center rounded-full bg-lime-tint text-xs font-bold text-lime-ink">A</span>
  </div>

  <div class="rounded-card border border-line bg-surface p-4 shadow-[0_0_40px_-14px_rgba(185,242,39,0.7)]">
    <p class="text-[11px] font-medium text-ink-2">Saldo total</p>
    <p class="mt-0.5 text-[26px] font-bold tracking-tight">$42,318.75</p>
    <div class="mt-3 grid grid-cols-2 gap-2 text-[11px]">
      <div class="rounded-ctl bg-canvas px-2.5 py-1.5">
        <p class="text-ink-2">Ingresos</p>
        <p class="font-semibold text-pos">+$18,500</p>
      </div>
      <div class="rounded-ctl bg-canvas px-2.5 py-1.5">
        <p class="text-ink-2">Gastos</p>
        <p class="font-semibold">−$6,214</p>
      </div>
    </div>
  </div>

  <p class="pb-2 pt-4 text-[13px] font-semibold">Recientes</p>
  <ul class="divide-y divide-line rounded-card border border-line bg-surface">
    {
      movements.map((m) => (
        <li class="flex items-center gap-2.5 px-3 py-2.5">
          <span class="h-7 w-7 shrink-0 rounded-full" style={`background:${m.color}22;box-shadow:inset 0 0 0 7px ${m.color}`} />
          <div class="min-w-0 flex-1">
            <p class="truncate text-[12px] font-medium">{m.name}</p>
            <p class="truncate text-[10px] text-ink-2">{m.sub}</p>
          </div>
          <span class:list={['text-[12px] font-semibold', m.pos && 'text-pos']}>{m.amount}</span>
        </li>
      ))
    }
  </ul>
</div>
<TabBar active="inicio" />
