---
const contributions = [
  { date: '15 oct', amount: '+$1,900.00' },
  { date: '30 sep', amount: '+$2,500.00' },
  { date: '15 sep', amount: '+$1,900.00' },
];
---

<div class="flex h-full flex-col px-4 pb-4">
  <div class="flex items-center gap-2 pb-3">
    <span class="text-lg leading-none text-ink-2">‹</span>
    <p class="text-lg font-bold">Viaje a Oaxaca</p>
  </div>

  <div class="relative overflow-hidden rounded-card bg-ink p-4 text-white shadow-[inset_0_0_0_1px_rgba(185,242,39,0.25)]">
    <div class="pointer-events-none absolute -right-10 -top-12 h-36 w-36 rounded-full bg-[radial-gradient(circle,rgba(185,242,39,0.45),transparent_70%)]"></div>
    <p class="text-[11px] text-white/60">Ahorrado</p>
    <p class="text-[28px] font-bold tracking-tight">$12,400<span class="text-base text-white/50">.00</span></p>
    <p class="text-[11px] text-white/60">de $20,000.00 · 62%</p>
    <div class="mt-3 h-2 rounded-full bg-white/15">
      <div class="lime-fill h-2 w-[62%] rounded-full"></div>
    </div>
    <p class="mt-3 text-[10px] text-white/60">Fecha límite: 15 dic 2026</p>
  </div>

  <p class="mt-3 rounded-ctl bg-lime-tint px-3 py-2 text-[11px] font-medium text-lime-ink">
    ↗ Vas $600.00 adelantado de tu ritmo planeado
  </p>

  <p class="pb-1.5 pt-4 text-[12px] font-semibold">Aportaciones</p>
  <ul class="divide-y divide-line rounded-card border border-line bg-surface">
    {
      contributions.map((c) => (
        <li class="flex justify-between px-3 py-2.5 text-[12px]">
          <span class="text-ink-2">{c.date} · Nu Ahorro</span>
          <span class="font-semibold text-pos">{c.amount}</span>
        </li>
      ))
    }
  </ul>

  <span class="lime-fill mt-auto flex h-11 items-center justify-center rounded-ctl text-[13px] font-semibold text-ink">
    Agregar aportación
  </span>
</div>
