---
/** The web app's desktop layout (≥1024px): sidebar + wide Inicio dashboard. Drawn at 1180×738. */
const nav = ['Inicio', 'Movimientos', 'Análisis'];
const finance = ['Cuentas', 'Categorías', 'Presupuestos', 'Objetivos', 'Personas'];
const bars = [30, 52, 22, 70, 41, 28, 88, 50, 36, 64, 26, 58, 46, 33, 60, 40, 72, 35, 48, 55];
const cats = [
  { name: 'Comida', amount: '$3,840', pct: 77, color: '#F59E0B' },
  { name: 'Transporte', amount: '$1,380', pct: 52, color: '#0EA5E9' },
  { name: 'Suscripciones', amount: '$620', pct: 28, color: '#E5484D' },
  { name: 'Salidas', amount: '$410', pct: 18, color: '#8B5CF6' },
];
const recent = [
  { name: 'Súper', sub: 'Comida › Súper · BBVA', amount: '−$842.50', color: '#F59E0B' },
  { name: 'Nómina', sub: 'Ingreso · Nu', amount: '+$18,500.00', color: '#16A34A', pos: true },
  { name: 'BBVA → Ahorro', sub: 'Transferencia', amount: '$3,000.00', color: '#9CA3AF' },
];
---

<div class="flex h-[738px] w-[1180px] bg-canvas text-ink">
  <aside class="flex w-[228px] flex-col border-r border-line bg-surface px-4 py-5 text-[14px]">
    <div class="flex items-center gap-2 px-2 font-bold"><img src="/favicon-48.png" alt="" width="26" height="26" class="rounded-lg" /> Genobills</div>
    <span class="lime-fill mt-5 flex h-10 items-center justify-center rounded-ctl text-[14px] font-semibold">+ Nuevo movimiento</span>
    <ul class="mt-5 space-y-0.5">
      {nav.map((n, i) => <li class:list={['rounded-ctl px-3 py-2', i === 0 ? 'bg-ink font-semibold text-white' : 'text-ink-2']}>{n}</li>)}
    </ul>
    <p class="mt-5 px-3 text-[11px] font-semibold uppercase tracking-wider text-ink-3">Finanzas</p>
    <ul class="mt-1.5 space-y-0.5 text-ink-2">
      {finance.map((n) => <li class="px-3 py-2">{n}</li>)}
    </ul>
    <div class="mt-auto flex items-center gap-2.5 px-2">
      <span class="flex h-8 w-8 items-center justify-center rounded-full bg-lime-tint text-[12px] font-bold text-lime-ink">A</span>
      <span class="font-medium">Ana Prueba</span>
    </div>
  </aside>

  <main class="flex-1 overflow-hidden px-8 py-6">
    <div class="flex items-end justify-between">
      <div>
        <p class="text-[13px] text-ink-2">Hola, Ana</p>
        <p class="text-[26px] font-bold tracking-tight">Inicio</p>
      </div>
      <span class="rounded-full border border-line bg-surface px-3.5 py-1.5 text-[13px] font-medium">Octubre 2026 ▾</span>
    </div>

    <div class="mt-5 grid grid-cols-3 gap-4">
      <div class="col-span-2 rounded-card border border-line bg-surface p-6 shadow-[0_0_60px_-24px_rgba(185,242,39,0.8)]">
        <p class="text-[13px] font-medium text-ink-2">Saldo total</p>
        <p class="mt-1 text-[40px] font-bold tracking-tight">$42,318.75</p>
        <div class="mt-4 flex gap-3 text-[13px]">
          <span class="rounded-ctl bg-canvas px-3.5 py-2"><span class="text-ink-2">Ingresos </span><b class="text-pos">+$18,500</b></span>
          <span class="rounded-ctl bg-canvas px-3.5 py-2"><span class="text-ink-2">Gastos </span><b>−$6,214</b></span>
        </div>
      </div>
      <div class="relative overflow-hidden rounded-card bg-ink p-6 text-white">
        <div class="absolute -right-10 -top-12 h-40 w-40 rounded-full bg-[radial-gradient(circle,rgba(185,242,39,0.4),transparent_70%)]"></div>
        <p class="text-[13px] text-white/60">Viaje a Oaxaca</p>
        <p class="mt-1 text-[28px] font-bold">$12,400</p>
        <p class="text-[12px] text-white/60">de $20,000 · 62%</p>
        <div class="mt-4 h-2 rounded-full bg-white/15"><div class="lime-fill h-2 w-[62%] rounded-full"></div></div>
      </div>

      <div class="col-span-2 rounded-card border border-line bg-surface p-6">
        <div class="flex justify-between text-[14px]"><b>Gasto diario</b><span class="text-ink-2">Octubre</span></div>
        <div class="mt-4 flex h-[150px] items-end gap-2">
          {bars.map((h, i) => <span class:list={['flex-1 rounded-t-[5px]', i === 6 ? 'lime-fill' : 'bg-line']} style={`height:${h}%`} />)}
        </div>
      </div>
      <div class="rounded-card border border-line bg-surface p-6">
        <b class="text-[14px]">Por categoría</b>
        <ul class="mt-3 space-y-3 text-[13px]">
          {
            cats.map((c) => (
              <li>
                <div class="flex justify-between"><span>{c.name}</span><b>{c.amount}</b></div>
                <div class="mt-1 h-1.5 rounded-full bg-line"><div class="h-1.5 rounded-full" style={`width:${c.pct}%;background:${c.color}`} /></div>
              </li>
            ))
          }
        </ul>
      </div>

      <ul class="col-span-3 divide-y divide-line rounded-card border border-line bg-surface">
        {
          recent.map((m) => (
            <li class="flex items-center gap-3 px-5 py-3">
              <span class="h-8 w-8 rounded-full" style={`background:${m.color}22;box-shadow:inset 0 0 0 8px ${m.color}`} />
              <div class="flex-1">
                <p class="text-[14px] font-medium">{m.name}</p>
                <p class="text-[12px] text-ink-2">{m.sub}</p>
              </div>
              <b class:list={['text-[14px]', m.pos && 'text-pos']}>{m.amount}</b>
            </li>
          ))
        }
      </ul>
    </div>
  </main>
</div>
