---
const budgets = [
  { name: 'Comida', period: 'Mensual', spent: '$3,840', limit: '$5,000', pct: 77, color: '#F59E0B' },
  { name: 'Transporte', period: 'Quincenal', spent: '$1,380', limit: '$1,500', pct: 92, color: '#0EA5E9', warn: 'Te quedan $120 · faltan 4 días' },
  { name: 'Salidas', period: 'Mensual', spent: '$410', limit: '$1,200', pct: 34, color: '#8B5CF6' },
  { name: 'Café', period: 'Semanal', spent: '$195', limit: '$300', pct: 65, color: '#A16207' },
];
---

<div class="px-4">
  <div class="flex items-center gap-2 pb-3">
    <span class="text-lg leading-none text-ink-2">‹</span>
    <p class="text-lg font-bold">Presupuestos</p>
  </div>
  <div class="mb-3 grid grid-cols-2 rounded-ctl bg-line p-0.5 text-center text-[11px] font-medium">
    <span class="rounded-[12px] bg-ink py-1.5 text-white">Activos</span>
    <span class="py-1.5 text-ink-2">Archivados</span>
  </div>
  <div class="space-y-2">
    {
      budgets.map((b) => (
        <article class:list={['rounded-card border bg-surface p-3', b.warn ? 'border-warning/40' : 'border-line']}>
          <div class="flex items-center gap-2">
            <span class="h-2.5 w-2.5 rounded-full" style={`background:${b.color}`} />
            <p class="flex-1 text-[12px] font-semibold">{b.name}</p>
            <span class="text-[10px] text-ink-2">{b.period}</span>
          </div>
          <p class="mt-1.5 text-[11px] text-ink-2">
            <span class="text-[13px] font-semibold text-ink">{b.spent}</span> de {b.limit}
          </p>
          <div class="mt-1.5 h-1.5 rounded-full bg-line">
            <div class:list={['h-1.5 rounded-full', b.warn ? 'bg-warning' : 'bg-lime']} style={`width:${b.pct}%`} />
          </div>
          {b.warn && <p class="mt-2 rounded-ctl bg-warning-tint px-2 py-1 text-[10px] font-medium text-warning">⚠ {b.warn}</p>}
        </article>
      ))
    }
  </div>
</div>
