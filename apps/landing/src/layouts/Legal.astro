---
import Base from './Base.astro';

/**
 * The legal pages (Aviso de privacidad, Política de cookies, Términos y
 * condiciones): one readable column, the version and date on top, and the
 * three documents linked at the bottom. The version must match
 * `LEGAL_VERSION` in @repo/core — the app asks people to accept it.
 */
interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;

const LEGAL_VERSION = '2026-10-22';
const LEGAL_UPDATED = '22 de octubre de 2026';

const docs = [
  { href: '/terminos', label: 'Términos y condiciones' },
  { href: '/privacidad', label: 'Aviso de privacidad' },
  { href: '/cookies', label: 'Política de cookies' },
];
const current = Astro.url.pathname.replace(/\/$/, '');
---

<Base title={`${title} — Genobills`} description={description}>
  <header class="border-b border-line-dark">
    <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-5 sm:px-6">
      <a href="/" class="flex items-center gap-2.5 font-bold text-ink-dark">
        <span class="flex h-9 w-9 items-center justify-center rounded-[11px] bg-lime font-black text-ink">G</span>
        Genobills
      </a>
      <a href="/" class="text-sm font-semibold text-ink-2-dark hover:text-ink-dark">← Inicio</a>
    </div>
  </header>

  <main class="mx-auto max-w-3xl px-4 pb-20 pt-12 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-widest text-lime">Legal</p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-ink-dark sm:text-5xl">{title}</h1>
    <p class="mt-3 text-sm text-ink-3-dark">
      Última actualización: {LEGAL_UPDATED} · Versión {LEGAL_VERSION}
    </p>

    <article class="legal mt-10">
      <slot />
    </article>
  </main>

  <footer class="border-t border-line-dark">
    <div class="mx-auto flex max-w-3xl flex-col gap-3 px-4 py-8 text-sm text-ink-2-dark sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p>© {new Date().getFullYear()} Genobills</p>
      <nav class="flex flex-wrap gap-x-4 gap-y-2">
        {
          docs.map((d) => (
            <a
              href={d.href}
              class={d.href === current ? 'font-semibold text-ink-dark' : 'hover:text-ink-dark'}
              aria-current={d.href === current ? 'page' : undefined}
            >
              {d.label}
            </a>
          ))
        }
      </nav>
    </div>
  </footer>
</Base>

<style is:global>
  .legal {
    color: #c9cdd2;
    font-size: 1rem;
    line-height: 1.75;
  }
  .legal h2 {
    margin-top: 2.75rem;
    margin-bottom: 0.75rem;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #f2f3f5;
  }
  .legal h3 {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: #f2f3f5;
  }
  .legal p,
  .legal ul,
  .legal ol {
    margin-top: 0.75rem;
  }
  .legal ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal ol {
    list-style: decimal;
    padding-left: 1.25rem;
  }
  .legal li {
    margin-top: 0.375rem;
  }
  .legal strong {
    color: #f2f3f5;
    font-weight: 600;
  }
  .legal a {
    color: #a3e635;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal .summary {
    margin-top: 0;
    border-radius: 20px;
    border: 1px solid #23272c;
    background: #16191d;
    padding: 1.25rem 1.5rem;
  }
  .legal .summary h2 {
    margin-top: 0;
    font-size: 1.05rem;
  }
  .legal .todo {
    border-radius: 6px;
    background: rgb(243 178 94 / 0.15);
    padding: 0 0.35rem;
    color: #f3b25e;
    font-weight: 600;
  }
  .legal table {
    margin-top: 1rem;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .legal th,
  .legal td {
    border-bottom: 1px solid #23272c;
    padding: 0.6rem 0.5rem;
    text-align: left;
    vertical-align: top;
  }
  .legal th {
    color: #f2f3f5;
    font-weight: 600;
  }
</style>
