---
import { fill, langOf, PAGES, texts } from '../i18n';
import Base from './Base.astro';

/**
 * The legal pages (Aviso de privacidad, Política de cookies, Términos y
 * condiciones — and their English translations under /en/): one readable
 * column, the version and date on top, and the three documents linked at the
 * bottom. The version must match `LEGAL_VERSION` in @repo/core — the app
 * asks people to accept it.
 */
interface Props {
  page: 'terms' | 'privacy' | 'cookies';
  title: string;
  description: string;
}

const { page, title, description } = Astro.props;

const LEGAL_VERSION = '2026-10-22';

const lang = langOf(Astro);
const other = lang === 'es' ? 'en' : 'es';
const { common, legal } = texts(lang);
const docs = (['terms', 'privacy', 'cookies'] as const).map((doc) => ({
  doc,
  href: PAGES[doc][lang],
  label: legal.documents[doc],
}));
---

<Base page={page} title={`${title} — Genobills`} description={description}>
  <header class="border-b border-line-dark">
    <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-5 sm:px-6">
      <a href={PAGES.home[lang]} class="flex items-center gap-2.5 font-bold text-ink-dark">
        <span class="flex h-9 w-9 items-center justify-center rounded-[11px] bg-lime font-black text-ink">G</span>
        Genobills
      </a>
      <div class="flex items-center gap-5 text-sm font-semibold text-ink-2-dark">
        <a href={PAGES[page][other]} hreflang={other} lang={other} aria-label={common.nav.languageLabel} class="hover:text-ink-dark">
          {common.nav.language}
        </a>
        <a href={PAGES.home[lang]} class="hover:text-ink-dark">{legal.home}</a>
      </div>
    </div>
  </header>

  <main class="mx-auto max-w-3xl px-4 pb-20 pt-12 sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-widest text-lime">{legal.eyebrow}</p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight text-ink-dark sm:text-5xl">{title}</h1>
    <p class="mt-3 text-sm text-ink-3-dark">
      {fill(legal.updated, { date: legal.updatedDate, version: LEGAL_VERSION })}
    </p>
    {
      legal.translation && (
        <p
          class="mt-6 rounded-2xl border border-line-dark px-4 py-3 text-sm text-ink-2-dark [&_a]:text-lime [&_a]:underline [&_a]:underline-offset-2"
          set:html={fill(legal.translation, { href: PAGES[page].es })}
        />
      )
    }

    <article class="legal mt-10">
      <slot />
    </article>
  </main>

  <footer class="border-t border-line-dark">
    <div class="mx-auto flex max-w-3xl flex-col gap-3 px-4 py-8 text-sm text-ink-2-dark sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p>© {new Date().getFullYear()} Genobills</p>
      <nav class="flex flex-wrap gap-x-4 gap-y-2">
        {
          docs.map((d) => (
            <a
              href={d.href}
              class={d.doc === page ? 'font-semibold text-ink-dark' : 'hover:text-ink-dark'}
              aria-current={d.doc === page ? 'page' : undefined}
            >
              {d.label}
            </a>
          ))
        }
      </nav>
    </div>
  </footer>
</Base>

<style is:global>
  .legal {
    color: #c9cdd2;
    font-size: 1rem;
    line-height: 1.75;
  }
  .legal h2 {
    margin-top: 2.75rem;
    margin-bottom: 0.75rem;
    font-size: 1.375rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #f2f3f5;
  }
  .legal h3 {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: #f2f3f5;
  }
  .legal p,
  .legal ul,
  .legal ol {
    margin-top: 0.75rem;
  }
  .legal ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal ol {
    list-style: decimal;
    padding-left: 1.25rem;
  }
  .legal li {
    margin-top: 0.375rem;
  }
  .legal strong {
    color: #f2f3f5;
    font-weight: 600;
  }
  .legal a {
    color: #a3e635;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal .summary {
    margin-top: 0;
    border-radius: 20px;
    border: 1px solid #23272c;
    background: #16191d;
    padding: 1.25rem 1.5rem;
  }
  .legal .summary h2 {
    margin-top: 0;
    font-size: 1.05rem;
  }
  .legal .todo {
    border-radius: 6px;
    background: rgb(243 178 94 / 0.15);
    padding: 0 0.35rem;
    color: #f3b25e;
    font-weight: 600;
  }
  .legal table {
    margin-top: 1rem;
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .legal th,
  .legal td {
    border-bottom: 1px solid #23272c;
    padding: 0.6rem 0.5rem;
    text-align: left;
    vertical-align: top;
  }
  .legal th {
    color: #f2f3f5;
    font-weight: 600;
  }
</style>
