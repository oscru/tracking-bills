# The URLs per environment live in .env.development (`astro dev`) and
# .env.production (`astro build`), both committed. To override one locally,
# copy the line into .env.development.local or .env.production.local
# (git-ignored); in Vercel, set it as an env var for that environment.
#
# PUBLIC_SITE_URL   the landing's own URL (canonical links, sitemap, hreflang)
# PUBLIC_APP_URL    the web app the "Entrar" / "Crear cuenta" buttons open
#
# Store listings. Leave empty until the apps are published: the buttons then
# show "Próximamente" instead of linking.
PUBLIC_APP_STORE_URL=
PUBLIC_PLAY_STORE_URL=
